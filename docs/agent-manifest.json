{
  "name": "Vamp",
  "manifestVersion": "3.0.0",
  "description": "Vamp Sync is the main Mac host for Vamp Control and Vamp Stream. Vamp Assistant provides a separate private AI workspace and remote connection.",
  "license": "Apache-2.0",
  "website": "https://thevamp.app/",
  "source": "https://github.com/Mesutcydev/vamp-suite",
  "releaseMetadata": "https://thevamp.app/release.json",
  "apps": {
    "sync": {
      "displayName": "Vamp Sync",
      "role": "Mac app-window host",
      "bundleId": "com.mesutcy.remotedesktop.minhost",
      "url": "https://thevamp.app/sync/"
    },
    "control": {
      "displayName": "Vamp Control",
      "platforms": [
        "macOS",
        "iOS",
        "iPadOS"
      ],
      "role": "Client",
      "url": "https://thevamp.app/#control"
    },
    "stream": {
      "displayName": "Vamp Stream",
      "platforms": [
        "iOS",
        "iPadOS"
      ],
      "role": "Focused visual client",
      "url": "https://thevamp.app/stream/"
    },
    "assistant": {
      "displayName": "Vamp Assistant",
      "role": "AI workspace and separate remote endpoint",
      "url": "https://thevamp.app/assistant/"
    }
  },
  "network": {
    "bonjourService": "_screenharbor._tcp",
    "signalingPort": 9471,
    "dataPort": 9472,
    "tlsSignalingPort": 9473,
    "remoteAccess": "Trusted LAN or private Tailscale"
  },
  "safety": {
    "requiresVisibleHostApproval": true,
    "agentMustVerifyFingerprint": true,
    "agentMayBypassMacOSPermissions": false,
    "agentMayDisableGatekeeper": false,
    "humanConfirmationRequiredForNewPeer": true,
    "publicPortForwardingSupported": false
  }
}

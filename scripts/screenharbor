#!/usr/bin/env bash
# screenharbor — Terminal control for the MacPair Host macOS app.
#
# Usage:
#   screenharbor start|stop|restart|open|status|ensure|path|version|pending|wait-pending
#        approve-pairing|approve-connection|reject-pairing|reject-connection [--json]
#        approve-pairing|approve-connection [--fingerprint <hex>]
#        wait-pending [--timeout <seconds>]
#
# Exit codes:
#   0  success / host ready
#   1  app not installed
#   2  installed but not advertising
#   3  permissions or setup required
#   4  unknown command / bad usage
#   5  no pending pairing/connection request
#   6  approval action did not clear the pending request
#   7  pending fingerprint does not match --fingerprint
#   8  wait-pending timed out

set -euo pipefail

BUNDLE_ID="uk.mesut.screenharbor.host"
URL_SCHEME="screenharbor"
SNAPSHOT_FILE="${HOME}/Library/Application Support/ScreenHarbor/host.widget.snapshot.json"
SIGNALING_PORT=9471
JSON=0
WAIT_PENDING_TIMEOUT=60
APPROVE_FINGERPRINT=""

usage() {
  sed -n '3,19p' "$0" | sed 's/^# \{0,1\}//'
  echo ""
  echo "Commands:"
  echo "  start                Launch app (if needed) and start the host runtime"
  echo "  stop                 Stop the host runtime"
  echo "  restart              Restart the host runtime"
  echo "  open                 Launch the app without sending a runtime action"
  echo "  status               Print host phase and connect address"
  echo "  ensure               Start host if needed; exit 0 only when ready"
  echo "  path                 Print resolved .app bundle path"
  echo "  version              Print installed app version and build number"
  echo "  pending              Print the pending trust request (name, fingerprint, deadline)"
  echo "  wait-pending         Block until a pending request appears"
  echo "  approve-pairing      Approve the pending device pairing request"
  echo "  approve-connection   Approve the pending client connection request"
  echo "  reject-pairing       Reject the pending device pairing request"
  echo "  reject-connection    Reject the pending client connection request"
  echo ""
  echo "Options:"
  echo "  --json               Machine-readable output for status/ensure/approval commands"
  echo "  --fingerprint <hex>  Approve only when the pending fingerprint matches"
  echo "  --timeout <seconds>  Timeout for wait-pending (default: 60)"
}

log() { [[ "$JSON" -eq 1 ]] || printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

resolve_app_path() {
  local candidate
  for candidate in "/Applications/MacPair Host.app" "/Applications/ScreenHarbor Host.app"; do
    if [[ -d "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  candidate=$(mdfind "kMDItemCFBundleIdentifier == '$BUNDLE_ID'" 2>/dev/null | head -1 || true)
  if [[ -n "$candidate" && -d "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi
  return 1
}

is_running() {
  pgrep -x "MacPair Host" >/dev/null 2>&1 && return 0
  pgrep -x "ScreenHarbor Host" >/dev/null 2>&1 && return 0
  local app_path
  app_path=$(resolve_app_path 2>/dev/null || true)
  [[ -n "$app_path" ]] && pgrep -f "$app_path" >/dev/null 2>&1
}

open_app() {
  local app_path
  app_path=$(resolve_app_path) || { err "MacPair Host is not installed (bundle: $BUNDLE_ID)"; exit 1; }
  open -a "$app_path"
}

open_action() {
  local action="$1"
  open_app
  open "${URL_SCHEME}://action/${action}"
}

read_snapshot_field() {
  local field="$1"
  [[ -f "$SNAPSHOT_FILE" ]] || return 1
  python3 - "$SNAPSHOT_FILE" "$field" <<'PY'
import json, sys
path, field = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    data = json.load(f)
value = data.get(field)
if value is None:
    sys.exit(1)
if isinstance(value, str):
    print(value)
else:
    print(json.dumps(value))
PY
}

read_pending_json() {
  read_snapshot_field pendingPairingRequest 2>/dev/null || true
}

has_pending_pairing_request() {
  [[ -f "$SNAPSHOT_FILE" ]] || return 1
  python3 - "$SNAPSHOT_FILE" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
pending = data.get("pendingPairingRequest")
sys.exit(0 if isinstance(pending, dict) else 1)
PY
}

fingerprint_matches() {
  local actual="$1" expected="$2"
  python3 - "$actual" "$expected" <<'PY'
import sys
actual = sys.argv[1].strip().lower()
expected = sys.argv[2].strip().lower()
sys.exit(0 if actual == expected else 1)
PY
}

print_pending_request() {
  local pending_json="$1"
  python3 - "$pending_json" "$JSON" <<'PY'
import json, sys
pending = json.loads(sys.argv[1])
as_json = sys.argv[2] == "1"
payload = {
    "displayName": pending.get("displayName"),
    "fingerprint": pending.get("fingerprint"),
    "deadline": pending.get("deadline"),
}
if as_json:
    print(json.dumps(payload, indent=2))
else:
    print(f"displayName: {payload['displayName']}")
    print(f"fingerprint: {payload['fingerprint']}")
    print(f"deadline: {payload['deadline']}")
PY
}

port_listening() {
  lsof -nP -iTCP:"$SIGNALING_PORT" -sTCP:LISTEN >/dev/null 2>&1
}

bonjour_advertising() {
  local tmp pid
  tmp=$(mktemp)
  dns-sd -B _screenharbor._tcp local >"$tmp" 2>&1 &
  pid=$!
  sleep 2
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  grep -q "_screenharbor._tcp" "$tmp"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

collect_status() {
  local app_path="" installed=0 running=0 phase="unknown" status_title="" host_name="" primary_address="" address_label=""
  local pending_pairing_json=""
  if app_path=$(resolve_app_path 2>/dev/null); then
    installed=1
  fi
  if is_running; then
    running=1
  fi
  if [[ -f "$SNAPSHOT_FILE" ]]; then
    phase=$(read_snapshot_field phase 2>/dev/null || echo "unknown")
    status_title=$(read_snapshot_field statusTitle 2>/dev/null || true)
    host_name=$(read_snapshot_field hostName 2>/dev/null || true)
    primary_address=$(read_snapshot_field primaryAddress 2>/dev/null || true)
    address_label=$(read_snapshot_field addressLabel 2>/dev/null || true)
    pending_pairing_json=$(read_pending_json)
  fi
  local advertising=0
  if port_listening || bonjour_advertising; then
    advertising=1
  fi
  if [[ "$phase" == "ready" || "$phase" == "connecting" || "$phase" == "live" ]]; then
    advertising=1
  fi

  if [[ "$JSON" -eq 1 ]]; then
    python3 - "$installed" "$running" "$phase" "$status_title" "$host_name" "$primary_address" "$address_label" "$advertising" "$app_path" "$pending_pairing_json" <<'PY'
import json, sys
installed, running, phase, status_title, host_name, primary_address, address_label, advertising, app_path, pending_pairing_json = sys.argv[1:]
pending_pairing_request = None
if pending_pairing_json:
    try:
        pending_pairing_request = json.loads(pending_pairing_json)
    except json.JSONDecodeError:
        pending_pairing_request = None
print(json.dumps({
    "bundleId": "uk.mesut.screenharbor.host",
    "installed": installed == "1",
    "running": running == "1",
    "phase": phase,
    "statusTitle": status_title or None,
    "hostName": host_name or None,
    "primaryAddress": primary_address or None,
    "addressLabel": address_label or None,
    "advertising": advertising == "1",
    "appPath": app_path or None,
    "pendingPairingRequest": pending_pairing_request,
}, indent=2))
PY
  else
    if [[ "$installed" -eq 0 ]]; then
      log "MacPair Host: not installed"
      return 1
    fi
    log "MacPair Host: installed at $app_path"
    log "Running: $([[ "$running" -eq 1 ]] && echo yes || echo no)"
    log "Phase: $phase"
    [[ -n "$status_title" ]] && log "Status: $status_title"
    [[ -n "$host_name" ]] && log "Host name: $host_name"
    [[ -n "$primary_address" ]] && log "Address: $primary_address ($address_label)"
    log "Advertising: $([[ "$advertising" -eq 1 ]] && echo yes || echo no)"
    if [[ -n "$pending_pairing_json" ]]; then
      log "Pending pairing/connection:"
      print_pending_request "$pending_pairing_json" | sed 's/^/  /'
    fi
  fi

  [[ "$installed" -eq 1 ]] || return 1
  if [[ "$phase" == "setup" ]]; then
    return 3
  fi
  if [[ "$advertising" -eq 1 || "$phase" == "ready" || "$phase" == "connecting" || "$phase" == "live" ]]; then
    return 0
  fi
  if [[ "$running" -eq 1 ]]; then
    return 2
  fi
  return 2
}

cmd_status() {
  collect_status
}

cmd_ensure() {
  local rc=0
  collect_status || rc=$?
  if [[ "$rc" -eq 1 ]]; then
    exit 1
  fi
  if [[ "$rc" -eq 0 ]]; then
    exit 0
  fi
  if [[ "$rc" -eq 3 ]]; then
    open_app
    exit 3
  fi
  open_action start
  local attempt
  for attempt in $(seq 1 15); do
    sleep 1
    collect_status && exit 0
    rc=$?
    [[ "$rc" -eq 3 ]] && exit 3
  done
  exit 2
}

cmd_version() {
  local app_path version build
  app_path=$(resolve_app_path) || { err "MacPair Host is not installed (bundle: $BUNDLE_ID)"; exit 1; }
  version=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$app_path/Contents/Info.plist" 2>/dev/null || true)
  build=$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$app_path/Contents/Info.plist" 2>/dev/null || true)
  if [[ -z "$version" || -z "$build" ]]; then
    err "Could not read version from $app_path/Contents/Info.plist"
    exit 1
  fi
  if [[ "$JSON" -eq 1 ]]; then
    python3 - "$version" "$build" "$app_path" <<'PY'
import json, sys
print(json.dumps({
    "version": sys.argv[1],
    "build": sys.argv[2],
    "appPath": sys.argv[3],
}, indent=2))
PY
  else
    log "MacPair Host $version ($build)"
    log "$app_path"
  fi
}

cmd_pending() {
  local pending_json
  pending_json=$(read_pending_json)
  if [[ -z "$pending_json" ]]; then
    if [[ "$JSON" -eq 1 ]]; then
      python3 - <<'PY'
import json
print(json.dumps({"ok": False, "error": "No pending pairing/connection request"}, indent=2))
PY
    else
      err "No pending pairing/connection request"
    fi
    exit 5
  fi
  print_pending_request "$pending_json"
}

cmd_wait_pending() {
  local timeout="$1" elapsed=0 pending_json=""
  while [[ "$elapsed" -lt "$timeout" ]]; do
    pending_json=$(read_pending_json)
    if [[ -n "$pending_json" ]]; then
      if [[ "$JSON" -eq 1 ]]; then
        python3 - "$pending_json" "$elapsed" <<'PY'
import json, sys
pending = json.loads(sys.argv[1])
elapsed = int(sys.argv[2])
print(json.dumps({
    "ok": True,
    "waitedSeconds": elapsed,
    "pendingPairingRequest": pending,
}, indent=2))
PY
      else
        print_pending_request "$pending_json"
      fi
      exit 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  if [[ "$JSON" -eq 1 ]]; then
    python3 - "$timeout" <<'PY'
import json, sys
print(json.dumps({
    "ok": False,
    "error": f"No pending request within {sys.argv[1]}s",
    "timeoutSeconds": int(sys.argv[1]),
}, indent=2))
PY
  else
    err "No pending request within ${timeout}s"
  fi
  exit 8
}

cmd_resolve_request() {
  local action="$1" label="$2" expected_fingerprint="${3:-}"
  local pending_json actual_fingerprint=""

  if ! has_pending_pairing_request; then
    if [[ "$JSON" -eq 1 ]]; then
      python3 - "$label" <<'PY'
import json, sys
print(json.dumps({"ok": False, "error": f"No pending {sys.argv[1]} request"}, indent=2))
PY
    else
      err "No pending $label request"
    fi
    exit 5
  fi

  if [[ -n "$expected_fingerprint" ]]; then
    pending_json=$(read_pending_json)
    actual_fingerprint=$(python3 - "$pending_json" <<'PY'
import json, sys
pending = json.loads(sys.argv[1])
print(pending.get("fingerprint", ""))
PY
)
    if ! fingerprint_matches "$actual_fingerprint" "$expected_fingerprint"; then
      if [[ "$JSON" -eq 1 ]]; then
        python3 - "$expected_fingerprint" "$actual_fingerprint" <<'PY'
import json, sys
print(json.dumps({
    "ok": False,
    "error": "Pending fingerprint does not match --fingerprint",
    "expected": sys.argv[1],
    "actual": sys.argv[2] or None,
}, indent=2))
PY
      else
        err "Pending fingerprint does not match --fingerprint"
        err "  expected: $expected_fingerprint"
        err "  actual:   ${actual_fingerprint:-<missing>}"
      fi
      exit 7
    fi
  fi

  open_action "$action"

  local attempt
  for attempt in $(seq 1 10); do
    sleep 0.5
    if ! has_pending_pairing_request; then
      if [[ "$JSON" -eq 1 ]]; then
        python3 - "$label" "$action" <<'PY'
import json, sys
print(json.dumps({"ok": True, "action": sys.argv[2], "request": sys.argv[1]}, indent=2))
PY
      else
        log "Resolved pending $label request"
      fi
      exit 0
    fi
  done

  if [[ "$JSON" -eq 1 ]]; then
    python3 - "$label" "$action" <<'PY'
import json, sys
print(json.dumps({"ok": False, "error": f"Pending {sys.argv[1]} request still active after {sys.argv[2]}", "action": sys.argv[2]}, indent=2))
PY
  else
    err "Pending $label request is still active"
  fi
  exit 6
}

parse_common_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) JSON=1 ;;
      -h|--help) usage; exit 0 ;;
      *) return 1 ;;
    esac
    shift || true
  done
  return 0
}

parse_approve_options() {
  APPROVE_FINGERPRINT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) JSON=1 ;;
      --fingerprint)
        shift || { err "--fingerprint requires a value"; exit 4; }
        APPROVE_FINGERPRINT="$1"
        ;;
      -h|--help) usage; exit 0 ;;
      *) err "Unknown option: $1"; usage; exit 4 ;;
    esac
    shift || true
  done
}

parse_wait_pending_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) JSON=1 ;;
      --timeout)
        shift || { err "--timeout requires a value"; exit 4; }
        WAIT_PENDING_TIMEOUT="$1"
        ;;
      -h|--help) usage; exit 0 ;;
      *) err "Unknown option: $1"; usage; exit 4 ;;
    esac
    shift || true
  done
}

main() {
  local cmd="${1:-}"
  shift || true

  local approve_fingerprint=""

  case "$cmd" in
    approve-pairing|approve-connection)
      parse_approve_options "$@"
      approve_fingerprint="$APPROVE_FINGERPRINT"
      case "$cmd" in
        approve-pairing) cmd_resolve_request approve-pairing "pairing" "$approve_fingerprint" ;;
        approve-connection) cmd_resolve_request approve-connection "connection" "$approve_fingerprint" ;;
      esac
      ;;
    reject-pairing|reject-connection)
      parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }
      case "$cmd" in
        reject-pairing) cmd_resolve_request reject-pairing "pairing" ;;
        reject-connection) cmd_resolve_request reject-connection "connection" ;;
      esac
      ;;
    wait-pending)
      parse_wait_pending_options "$@"
      cmd_wait_pending "$WAIT_PENDING_TIMEOUT"
      ;;
    start)              parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; open_action start ;;
    stop)               parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; open_action stop ;;
    restart)            parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; open_action restart ;;
    open)               parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; open_app ;;
    path)
      parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }
      resolve_app_path || { err "MacPair Host is not installed"; exit 1; }
      ;;
    status)             parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; cmd_status ;;
    ensure)             parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; cmd_ensure ;;
    version)            parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; cmd_version ;;
    pending)            parse_common_options "$@" || { err "Unknown option: $1"; usage; exit 4; }; cmd_pending ;;
    ""|-h|--help)       usage ;;
    *) err "Unknown command: $cmd"; usage; exit 4 ;;
  esac
}

main "$@"

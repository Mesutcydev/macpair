# The public repository exposes only the account-independent release tools
scripts/*
!scripts/screenharbor
!scripts/package-screenharbor.sh
!scripts/install-screenharbor-cli.command
!scripts/publish-screenharbor.sh
!scripts/generate-screenharbor-sbom.sh
!scripts/package-screenharbor-ios.sh
!scripts/generate-vamp-sbom.sh
!scripts/generate-pages-release.py
!scripts/package-vamp-control-macos.sh
!scripts/package-vamp-control-ios.sh
!scripts/vamp-host-watchdog
!scripts/install-vamp-host-watchdog.sh

# Vamp Terminal is the account-independent open-source sideload target. Keep
# only the active hand-maintained project inputs visible; stale project copies
# and local Xcode state remain ignored.
!RemoteDesktopToolApps.xcodeproj/
RemoteDesktopToolApps.xcodeproj/*
!RemoteDesktopToolApps.xcodeproj/project.pbxproj
!RemoteDesktopToolApps.xcodeproj/xcshareddata/
RemoteDesktopToolApps.xcodeproj/xcshareddata/*
!RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/
RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/*
!RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/VampTerminalApp.xcscheme
!RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/VampTerminalHost.xcscheme
!RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/MacHost.xcscheme
!RemoteDesktopToolApps.xcodeproj/xcshareddata/xcschemes/iOSRemote.xcscheme

!Configuration/
Configuration/*
!Configuration/VampTerminal-Info.plist
!Configuration/VampTerminal.entitlements
!Configuration/VampTerminalHost-Info.plist
!Configuration/VampTerminalHost.entitlements
!Configuration/MacHost-Info.plist
!Configuration/MacHost-AppStore.entitlements
!Configuration/ClientiOS-Info.plist
!Configuration/ClientiOS.entitlements
!Configuration/ClientiOSLiveActivity-Info.plist

# The active project still references the shared Mac host/client asset and
# configuration inputs. Keep those build inputs while excluding stale copies.
!Sources/HostApp/Assets.xcassets/
!Sources/HostApp/Assets.xcassets/**
Sources/HostApp/Assets.xcassets/.DS_Store

!Sources/VampTerminal/Assets.xcassets/
!Sources/VampTerminal/Assets.xcassets/**
!scripts/package-vamp-terminal-ios.sh
!scripts/package-vamp-hosts.sh
!scripts/install-vamp-cli.command
!scripts/vamp
!scripts/vamp-linux-host
!scripts/vamp-terminal-host

# Legacy client signing and branded asset files are not used by ScreenHarbor.xcodeproj
MacClient/Resources/Assets.xcassets/
MacClient/Resources/MacClient-Info.plist
MacClient/Resources/MacClient.entitlements
MacClient/Resources/MacClient-Release.entitlements

